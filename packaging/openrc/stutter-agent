#!/sbin/openrc-run

name="stutter agent"
description="Stutter remote agent with autotune emergency restore on stop"

command="${stutter_command:-/usr/bin/stutter}"
if [ -n "${stutter_bind:-}" ]; then
	command_args="agent --bind ${stutter_bind} ${stutter_extra_args:-}"
else
	command_args="agent --unix-socket ${stutter_socket:-/run/stutter/agent.sock} ${stutter_extra_args:-}"
fi
command_background="yes"
pidfile="${stutter_pidfile:-/run/${RC_SVCNAME}.pid}"

depend() {
	need localmount
	after net
}

start_pre() {
	checkpath --directory --mode 0755 /run/stutter
}

stop_pre() {
	ebegin "Restoring active stutter daemon actions"
	"${command}" daemon emergency-restore
	eend $?
}
