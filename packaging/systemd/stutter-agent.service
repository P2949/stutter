[Unit]
Description=Stutter remote agent
Documentation=https://github.com/P2949/stutter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/stutter/agent.env
ExecStart=/usr/bin/stutter agent --unix-socket /run/stutter/agent.sock
ExecStop=/usr/bin/stutter daemon emergency-restore
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
StateDirectory=stutter
LogsDirectory=stutter
RuntimeDirectory=stutter
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/stutter /var/log/stutter /run

# The agent can perform system tuning and restore operations, so do not
# enable hardening options here that would block /proc, /sys, cgroup, or
# scheduler syscalls. Downstream packagers may add site-specific sandboxing
# after confirming their enabled actions still restore correctly.

[Install]
WantedBy=multi-user.target
