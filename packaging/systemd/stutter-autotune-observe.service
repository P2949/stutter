[Unit]
Description=stutter autotune observe controller
Documentation=https://github.com/P2949/stutter
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/stutter/autotune-observe.env
Environment=HOME=/var/lib/stutter
Environment=STUTTER_AUTOTUNE_MODE=observe
Environment=STUTTER_AUTOTUNE_PRESET=diagnosis
Environment=STUTTER_AUTOTUNE_SUMMARY_MS=1000
Environment=STUTTER_AUTOTUNE_FOCUS_SOURCE=hybrid
ExecStart=/bin/sh -eu -c '\
mode="${STUTTER_AUTOTUNE_MODE:-observe}"; \
preset="${STUTTER_AUTOTUNE_PRESET:-diagnosis}"; \
summary_ms="${STUTTER_AUTOTUNE_SUMMARY_MS:-1000}"; \
focus_source="${STUTTER_AUTOTUNE_FOCUS_SOURCE:-hybrid}"; \
watch_process="${STUTTER_AUTOTUNE_WATCH_PROCESS:-}"; \
tree_pid="${STUTTER_AUTOTUNE_TREE_PID:-}"; \
if [ "$mode" != "observe" ]; then \
  echo "stutter-autotune-observe only supports STUTTER_AUTOTUNE_MODE=observe" >&2; \
  exit 64; \
fi; \
if [ -n "$watch_process" ] && [ -n "$tree_pid" ]; then \
  echo "set only one of STUTTER_AUTOTUNE_WATCH_PROCESS or STUTTER_AUTOTUNE_TREE_PID" >&2; \
  exit 64; \
fi; \
if [ -n "$watch_process" ]; then \
  exec /usr/bin/stutter autotune --mode observe --watch-process "$watch_process" --preset "$preset" --summary-ms "$summary_ms" --foreground-window --focus-source "$focus_source"; \
fi; \
if [ -n "$tree_pid" ]; then \
  exec /usr/bin/stutter autotune --mode observe --tree-pid "$tree_pid" --preset "$preset" --summary-ms "$summary_ms" --foreground-window --focus-source "$focus_source"; \
fi; \
exec /usr/bin/stutter autotune --mode observe --auto-focus --focus-source "$focus_source" --preset "$preset" --summary-ms "$summary_ms"'
Restart=on-failure
RestartSec=5s
StateDirectory=stutter
LogsDirectory=stutter
RuntimeDirectory=stutter
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/stutter /var/log/stutter /run

[Install]
WantedBy=multi-user.target
